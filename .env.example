# Copy to .env and fill in ONE provider key. Provider auto-detects from the key
# present (OpenAI preferred), or force it with MEDIA_ENGINE_PROVIDER.

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-...
# Cost per full run (approx): gpt-4o-mini ~$0.03 | gpt-4.1-mini ~$0.05 | gpt-5.5 ~$1+
MEDIA_ENGINE_OPENAI_MODEL=gpt-4o-mini

# Web search is ~80% of per-run cost. on = live trending; off = model knowledge
# only (near-free, not live). Default on.
MEDIA_ENGINE_WEB_SEARCH=on

# Image backend: template = free Pillow card; openai = generative poster
# (~$0.05-0.17/image). Quality: low | medium | high.
MEDIA_ENGINE_IMAGE_BACKEND=template
MEDIA_ENGINE_IMAGE_QUALITY=medium

# --- Anthropic (alternative) ---
# ANTHROPIC_API_KEY=sk-ant-...
# MEDIA_ENGINE_MODEL=claude-opus-4-8
# MEDIA_ENGINE_EFFORT=high

# Force a provider (optional): openai | anthropic
# MEDIA_ENGINE_PROVIDER=openai

# --- Writing models: an ordered fallback chain (optional) ---
# "provider:model" entries, tried in order for every writing call; a free tier
# that is rate-limited or down falls through to the next. Entries whose key is
# missing are skipped. Unset = the single provider above.
# Providers: openai, gemini, openrouter, groq, deepseek, kimi, mistral, anthropic.
# Tested 2026-10-06 on one YouTube packaging job: gemini-3.5-flash-lite was the
# best free writer (3s); gemini 3.5/3.7/3.8-flash returned 503 "high demand" on
# the free tier; OpenRouter's free models took 45-60s and invented details.
# GEMINI_API_KEY=            # free, no card: https://aistudio.google.com/api-keys
# OPENROUTER_API_KEY=        # free models end in ":free"; 50 requests/day
# GROQ_API_KEY=
# MEDIA_ENGINE_WRITERS=gemini:gemini-3.5-flash-lite,gemini:gemini-flash-latest,openai:gpt-4o-mini

# Live research through Gemini's Google Search grounding instead of OpenAI.
# NOTE: on a free-tier key this returned 429 "quota exceeded" (2026-10-06) -
# it appears to need billing enabled. Left here for when it does.
# MEDIA_ENGINE_SEARCH=gemini:gemini-3.5-flash-lite

# --- Auto-publish policy (used by: python cli.py --auto "topic") ---
# Both default off/false. Sensitive topics ALWAYS hold for a human regardless.
MEDIA_ENGINE_AUTOPUBLISH=false   # true = fire clean posts without asking
MEDIA_ENGINE_LIVE=false          # false = dry-run even when auto (safe default)
MEDIA_ENGINE_PLATFORMS=all       # or e.g. "twitter,linkedin"

# --- Publishing (NOT used in v0; wired in v3) ---
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# IG_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
